{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && cap sync",
    "build:clientes": "APP_TARGET=clientes vite build",
    "build:repartidores": "APP_TARGET=repartidores vite build",
    "build:admin": "APP_TARGET=admin vite build",
    "build:all": "npm run build:clientes && npm run build:repartidores && npm run build:admin",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-rayo-test",
    "test:emulator": "NODE_ENV=test tsx --test tests/emulator-rules.test.ts tests/emulator-checkout.test.ts",
    "test:emulator:real": "firebase emulators:exec --only firestore,auth --project demo-rayo-test \"npx tsx --test tests/real-emulator-suite.test.ts\"",
    "verify:isolation": "npx tsx scripts/verify-ci-isolation.ts",
    "test:shutdown": "NODE_ENV=test tsx --test tests/graceful-shutdown.test.ts",
    "test:staging": "NODE_ENV=test tsx --test tests/checkout.test.ts tests/fase7a-security.test.ts tests/emulator-rules.test.ts tests/emulator-checkout.test.ts tests/graceful-shutdown.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "~5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
